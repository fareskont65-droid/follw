<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة تحكم تجريبية - SMM PoC</title>
    <style>
        body { font-family: Tahoma, sans-serif; background: #0f172a; color: #f8fafc; margin: 0; padding: 20px; }
        h1 { text-align: center; color: #38bdf8; }
        .container { max-width: 1000px; margin: 0 auto; background: #1e293b; padding: 20px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.3); }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { padding: 12px; text-align: center; border-bottom: 1px solid #334155; }
        th { background: #334155; color: #38bdf8; }
        button { background: #0284c7; color: white; border: none; padding: 8px 12px; border-radius: 5px; cursor: pointer; transition: 0.2s; }
        button:hover { background: #0369a1; }
        .status { font-weight: bold; color: #4ade80; }
    </style>
</head>
<body>
    <div class="container">
        <h1>لوحة تحكم الأتمتة المصغرة (50 صفحة)</h1>
        <table>
            <thead>
                <tr>
                    <th>#ID</th>
                    <th>اسم الصفحة / الرابط</th>
                    <th>اللايكات</th>
                    <th>المشاهدات</th>
                    <th>الحالة</th>
                    <th>الإجراء</th>
                </tr>
            </thead>
            <tbody>
                <% pages.forEach(page => { %>
                    <tr id="row-<%= page.id %>">
                        <td><%= page.id %></td>
                        <td><%= page.name %></td>
                        <td id="likes-<%= page.id %>"><%= page.likes %></td>
                        <td id="views-<%= page.id %>"><%= page.views %></td>
                        <td class="status" id="status-<%= page.id %>"><%= page.status %></td>
                        <td>
                            <button onclick="boostPage(<%= page.id %>, 'likes')">زيادة لايكات</button>
                            <button onclick="boostPage(<%= page.id %>, 'views')" style="background: #10b981;">زيادة مشاهدات</button>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <script>
        async function boostPage(pageId, serviceType) {
            const statusEl = document.getElementById(`status-${pageId}`);
            statusEl.innerText = "جاري المعالجة ⌛...";
            
            try {
                let response = await fetch('/boost', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ pageId, serviceType })
                });
                let result = await response.json();
                if(result.success) {
                    setTimeout(() => {
                        location.reload(); // تحديث الصفحة لرؤية القيم الجديدة
                    }, 1600);
                }
            } catch (err) {
                statusEl.innerText = "فشل الطلب ❌";
            }
        }
    </script>
</body>
</html>
