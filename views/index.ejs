<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة SMM الديناميكية المتقدمة</title>
    <style>
        body { font-family: Tahoma, sans-serif; background: #0f172a; color: #f8fafc; margin: 0; padding: 20px; }
        h1, h2 { text-align: center; color: #38bdf8; }
        .container { max-width: 1000px; margin: 0 auto; background: #1e293b; padding: 20px; border-radius: 10px; box-shadow: 0 4px 6px rgba(0,0,0,0.3); }
        .form-box { background: #334155; padding: 15px; border-radius: 8px; margin-bottom: 20px; display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }
        input { padding: 10px; border-radius: 5px; border: 1px solid #475569; background: #1e293b; color: #fff; flex: 1; min-width: 200px; }
        button { background: #0284c7; color: white; border: none; padding: 10px 15px; border-radius: 5px; cursor: pointer; transition: 0.2s; font-weight: bold; }
        button:hover { background: #0369a1; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { padding: 12px; text-align: center; border-bottom: 1px solid #334155; word-break: break-all; }
        th { background: #334155; color: #38bdf8; }
        .status { font-weight: bold; color: #4ade80; }
        .queue-info { text-align: center; color: #fbbf24; margin-bottom: 10px; font-weight: bold; }
    </style>
</head>
<body>
    <div class="container">
        <h1>لوحة تحكم الأتمتة الديناميكية (SMM PoC)</h1>
        
        <!-- نموذج إضافة رابط جديد -->
        <div class="form-box">
            <input type="text" id="targetName" placeholder="اسم صاحب الحساب أو المنصة">
            <input type="text" id="targetUrl" placeholder="ألصق رابط الحساب هنا (Profile URL)">
            <button onclick="addTarget()">إضافة الرابط للنظام ➕</button>
        </div>

        <div class="queue-info">حالة الطابور الحالي: <span><%= queueLength %></span> طلبات قيد الانتظار</div>

        <table>
            <thead>
                <tr>
                    <th>#ID</th>
                    <th>الاسم / الحساب</th>
                    <th>الرابط المستهدف</th>
                    <th>المتابعين</th>
                    <th>الحالة</th>
                    <th>الإجراء</th>
                </tr>
            </thead>
            <tbody>
                <% pages.forEach(page => { %>
                    <tr>
                        <td><%= page.id %></td>
                        <td><%= page.name %></td>
                        <td><a href="<%= page.url %>" target="_blank" style="color: #38bdf8;"><%= page.url %></a></td>
                        <td><%= page.followers %></td>
                        <td class="status"><%= page.status %></td>
                        <td>
                            <button onclick="boostTarget(<%= page.id %>)">إرسال 500 متابع 🚀</button>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <script>
        async function addTarget() {
            const targetName = document.getElementById('targetName').value;
            const targetUrl = document.getElementById('targetUrl').value;
            
            if(!targetUrl) {
                alert('الرجاء إدخال الرابط على الأقل!');
                return;
            }

            let response = await fetch('/add-target', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ targetName, targetUrl })
            });
            let result = await response.json();
            if(result.success) {
                location.reload();
            }
        }

        async function boostTarget(pageId) {
            let response = await fetch('/boost', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ pageId, amount: 500 })
            });
            let result = await response.json();
            if(result.success) {
                setTimeout(() => {
                    location.reload();
                }, 1500);
            }
        }
    </script>
</body>
</html>
